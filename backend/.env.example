# Copy to backend/.env and fill in what you need. Every setting is optional; the app runs with none.
# All variables use the GPS_ prefix. Restart the backend after editing (--reload does not watch .env).

# --- AI features (Gemini) ---------------------------------------------------
# Enables: narration scripts, citation checks, claim evidence checks, disagreement finder,
# claim extraction and the primary-source web search. Key: https://aistudio.google.com/apikey
GPS_GEMINI_API_KEY=
# Any current Gemini text model your key can use. Change this if you get "model not found".
GPS_GEMINI_MODEL=gemini-2.5-flash
# Seconds to wait for a Gemini answer (scripts for long videos can take a while).
GPS_GEMINI_TIMEOUT_SECONDS=180

# --- Published fact-check lookup (Google Fact Check Tools API) --------------
# Google Cloud console -> enable "Fact Check Tools API" -> create an API key.
GPS_FACTCHECK_API_KEY=

# --- Access control ---------------------------------------------------------
# Leave the password empty for local use. Set it before exposing the app on a network;
# the browser will then ask for these credentials (the /api/health probe stays open).
GPS_AUTH_USERNAME=admin
GPS_AUTH_PASSWORD=

# --- Feed scanning ----------------------------------------------------------
# Background scan every N minutes; 0 = only when you click Scan.
GPS_SCAN_INTERVAL_MINUTES=0
# Feeds downloaded in parallel during a scan.
GPS_MAX_CONCURRENT_FEEDS=5
# Per-feed download timeout in seconds.
GPS_REQUEST_TIMEOUT_SECONDS=12

# --- Storage & debugging ----------------------------------------------------
# SQLite file relative to backend/ by default.
GPS_DATABASE_URL=sqlite+aiosqlite:///./global_pulse.db
# Logs every SQL statement when true.
GPS_DEBUG=false
